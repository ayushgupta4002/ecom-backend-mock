# Copy this file to .env and adjust as needed:
#   cp .env.example .env      (or: make env)
#
# Real environment variables always take precedence over values in .env,
# so a deployment can override any of these without editing files.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Postgres connection string. Matches the `db` service in docker-compose.yml.
# NOTE: the test suite runs against this same database and TRUNCATEs all
# tables between tests, so do not point it at data you care about.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecom?sslmode=disable

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------
HTTP_ADDR=:8080

# ---------------------------------------------------------------------------
# Reward program
# ---------------------------------------------------------------------------
# n: every nth successfully placed order makes one coupon available.
# Must be greater than 0.
REWARD_MILESTONE_N=5

# x: the percentage discount a generated coupon grants (0-100).
# Applied to the cart subtotal at checkout.
REWARD_DISCOUNT_PERCENT=10

# ---------------------------------------------------------------------------
# Migrations and seed data
# ---------------------------------------------------------------------------
# Paths are relative to the working directory the server is started from.
MIGRATIONS_DIR=migrations
SEED_DIR=seed

# Set to "true" to skip loading seed data (e.g. in a production deployment).
SKIP_SEED=false
